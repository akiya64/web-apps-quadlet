[Unit]
Description=MariaDB Friendica Database

[Install]
WantedBy=friendica.service multi-user.target default.target

[Container]
Image=docker.io/library/mariadb:latest
Volume=/%h/pods/friendica/db_data:/var/lib/mysql
Environment=MYSQL_ROOT_PASSWORD=wordpress MYSQL_DATABASE=friendica MYSQL_USER=friendica
Secret=friendica-db-pass,type=env,target=MYSQL_PASSWORD
Secret=friendica-db-root-pass,type=env,target=MYSQL_ROOT_PASSWORD

[Service]
Restart=always
