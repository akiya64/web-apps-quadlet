[Unit]
Description=Friendica Server
After=friendicadb.service

[Container]
ContainerName=friendica-fpm
Environment=MYSQL_HOST=127.0.0.1:3306 MYSQL_USER=friendica MYSQL_DATABASE=friendica FRIENDICA_ADMIN_MAIL=autumnsky64@gmail.com
Environment=FRIENDICA_URL=https://fedi.autumnsky.jp
Pod=friendica.pod
Image=docker.io/library/friendica:stable-fpm-alpine
Volume=%h/pods/friendica/html:/var/www/html
Secret=friendica-db-pass,type=env,target=MYSQL_PASSWORD

[Service]
Restart=always
