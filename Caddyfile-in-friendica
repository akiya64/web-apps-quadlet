:8080 {
    root * /var/www/html

    php_fastcgi friendica-fpm:9000
    file_server
    encode zstd gzip

    @not_file {
        not file {path}
    }
    rewrite @not_file /index.php?pagename={path}

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
