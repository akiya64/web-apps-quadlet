:8080 {
	root * /var/www/html

	route {
		@notStatic {
			not file {path}
		}
    rewrite @notStatic /index.php?q={path}&{query}

		php_fastcgi friendica-fpm:9000

		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
