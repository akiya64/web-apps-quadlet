:8080 {
    root * /var/www/html

    php_fastcgi 127.0.0.1:9000
    file_server
    encode zstd gzip

    @not_file {
        not file {path}
    }
    rewrite @not_file /index.php?q={path}&{query}


    header {
        X-Content-Type-Options nosniff
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
